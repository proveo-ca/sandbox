@startuml HostAndroidADB
!include https://raw.githubusercontent.com/proveo-ca/identity/main/proveo.puml
skinparam noteTextAlignment left
' purpose: how an sbx agent drives an Android emulator on the host — host adb server dialled by IP, adb forwards mirrored into the VM, mobile-mcp tools on the harness's own model
' covers: internal/hostadb/hostadb.go
' covers: internal/hostadb/hostadb_test.go
' covers: internal/adbmirror/adbmirror.go
' covers: internal/adbmirror/adbmirror_test.go
' covers: cmd/proveo-entrypoint/main.go (adb-mirror)
' covers: internal/run/choices.go (addonAndroid, addonIOS, interfaceOptions, gateAddons, addonAliases, resolveAddonFlags)
' covers: internal/run/run.go (startHostADB)
' covers: internal/run/topology.go (interfaceOf)
' covers: internal/run/host_adb_test.go
' covers: internal/manifest/manifest.go (capabilities.hostDevices)
' covers: internal/backend/sandbox/sandbox.go (Spec allow, withMobileMCP, withLocalModelTools, launchConfigEnv, EnvHostOS)
' covers: internal/backend/sandbox/host_adb_test.go
' covers: packages/lib/entrypoint-lib.sh (proveo_host_adb_env, proveo_adb_mirror_start, proveo_mobile_mcp_exec, ensure_jvm_toolchain, proveo_install_claude_env_hook, _proveo_persist_tool_env, proveo_apply_ui_defaults)
' covers: internal/contract/claude_env_hook_test.go
' covers: internal/contract/host_devices_test.go
' covers: internal/egress/plan.go (localModelArgs)
' covers: defs/base/Dockerfile (adb, qemu floor)
' covers: defs/base/proveo-aapt2
' covers: defs/opencode/harness.manifest (capabilities.hostDevices)
' covers: defs/claudecode/mcp/entrypoint.sh (CLAUDE_LOCAL_ARGS)
' covers: internal/contract/jvm_toolchain_test.go
' covers: internal/contract/host_adb_lib_test.go
' covers: defs/claudecode/harness.manifest (capabilities.hostDevices)
' covers: e2e/host_adb_sbx_test.go
' covers: e2e/android_addon_test.go
' covers: e2e/android_app_test.go
