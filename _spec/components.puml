@startuml ProveoComponents
!includeurl https://raw.githubusercontent.com/proveo-ca/identity/refs/heads/main/proveo.iuml
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 80
' purpose: the component map of the whole repo — binaries, packages and defs
' covers: cmd/**
' covers: internal/**
' covers: defs/**
' covers: packages/**
' covers: embed.go

' Top-down, deliberately. Left-to-right laid this out as a 4000px column once the
' cross-group edges became package-level: the groups stack instead of spreading,
' and every long edge runs the full height. Top-down is 44% smaller and wide.
'
' ── 2026-10-16: ONE BACKEND ────────────────────────────────────────────────
' The docker+egress backend is DELETED ("Retire Docker egress"; "Refuse without
' sbx"), MEASURED absent: cmd/proveo-egress, internal/backend/dockeregress,
' internal/egress, internal/egressproxy, internal/egresspolicy, internal/broker,
' internal/reviewgate, defs/sidecars (egress-proxy, squid-proxy, mitmproxy),
' defs/egress-dashboard. embed.go embeds the manifests only; goreleaser builds
' proveo only; internal/runner holds only `type Mount`. The docker emitter and
' the Sidecars package left this map with them.

title Proveo Project Component Map
' A one-screen view of the same system: overview.puml (same directory). This map is
' the inventory — every package and edge; that one is the shape a newcomer needs first.

actor "Consumer" as Consumer
actor "Maintainer" as Maintainer
actor "AI Agent" as Agent

package "Repository Root" as RepoRoot {
 component "README / CONVENTIONS" as RootDocs <<doc>>
 component "pnpm workspace" as WorkspaceConfig <<config>>
 component "mise toolchain" as ToolchainConfig <<config>>
 component "embed.go\n//go:embed manifests" as Embed <<config>>
}

package "Specifications\n_spec/" as Specs {
 component "overview.puml · components.puml" as ComponentsSpec <<spec>>
 component "usage.puml" as UsageSpec <<spec>>
 component "_paradigms/*.puml" as Paradigms <<spec>>
 component "tests/*.puml" as TestingSpec <<spec>>
 component "per-harness paradigm + topology" as HarnessSpecs <<spec>>
}

package "Go CLI + packages\ncmd/ + internal/" as GoSurface {
 component "cmd/proveo\nlist · run · projects · setup" as ProveoCLI <<app>>
 component "cmd/proveo-entrypoint\nprocess-external prelude only\n(cwd + exports cannot cross)" as ProveoEP <<app>>
 package "internal/" as Internals {
 component "manifest\nharness.manifest" as Manifest <<app>>
 component "run\nrequireSandbox · choices · posture" as Runner <<app>>
 component "workspace\nscope + mount plan" as Workspace <<app>>
 component "backend/sandbox · sbx\nKit · sbx argv · secret store" as EgressPkg <<app>>
 component "provider · credentials\nregistry · detection · store names" as CredPkg <<app>>
 component "gitidentity\nGIT_* forwarding" as GitId <<app>>
 component "entrypoint\n.env guard (sbx env) · bridges" as EPPkg <<app>>
 component "proveohome\n~/.proveo mounts + deny scrub" as HomePkg <<app>>
 component "cdn\nlatest.json · checksum update" as CdnPkg <<app>>
 component "maintain\nbuild · test · deploy registry" as MaintainPkg <<app>>
 component "imagebuild\nSpecs table · buildx · agent pin" as ImageBuildPkg <<app>>
 component "verify\nverification-command discovery" as VerifyPkg <<app>>
 component "clean\nreclaim plan (liveness-safe)" as CleanPkg <<app>>
 component "shell\ncross-shell PATH setup" as ShellPkg <<app>>
 component "tmux · ui · contract\ntest driver · output · gates" as SupportPkg <<app>>
 }
}

package "Definitions\ndefs/" as Defs {
 package "Coding harnesses" as CodingDefs {
 component "cecli" as DefCecli <<definition>>
 component "claudecode\nmcp + solidity" as DefClaude <<definition>>
 component "opencode" as DefOpen <<definition>>
 component "cursor" as DefCursor <<definition>>
 }
 component "harness.manifest\nper def (registration)" as HarnessManifest <<config>>
 component "Dockerfiles · entrypoints\n(builds: internal/imagebuild\ntests: internal/imagetest)" as DefBuild <<script>>
 component "defaults · agents · samples" as DefAssets <<config>>
}

package "Maintainer tools" as Maint {
 component "mise tasks\nbuild · test · deploy" as Mise <<internal>>
 component "cmd/proveo-dev (not shipped)\ncoverage · stage-cdn · debug · lint · hooks" as MaintLib <<app>>
}

package "Distribution" as Dist {
 component "goreleaser\nproveo" as Goreleaser <<config>>
 component "dist/install.sh\nchecksum-verified" as Installer <<script>>
 component "apps/cli (optional CDN)\nrelease assets only" as CliCDN <<app>>
}

package "Artifacts" as Artifacts {
 component "proveo/* harness images" as HarnessImgs <<image>>
}

package "Launch" as Launch {
 component "LaunchSpec\nenv · seed steps · agent argv\nresolved ONCE, host-side" as LaunchSpec <<app>>
 component "Kit emitter (sbx)\nkind: mixin beside a built-in agent" as KitEmit <<app>>
 component "proveo_seed\nfile-shaped setup" as Seed <<app>>
}

package "Runtime" as Runtime {
 component "sbx (+ Docker for images)" as Docker <<runtime>>
 component "host workspace" as HostWS <<workspace>>
 component "state dir\nper-run Kit · policy log · run log" as State <<storage>>
 component "provider APIs" as Providers <<external>>
}

' ── Actors reach a GROUP, never a component inside one ──────────────────────
Consumer ..> GoSurface : installed binary
Consumer ..> Dist : curl install + checksum
Maintainer ..> Maint : repo workflows
Maintainer ..> GoSurface : proveo run / --print
Maintainer ..> Defs : build images
Agent ..> RepoRoot : collaboration rules
Agent ..> Specs : architecture context

' ── Between groups: ONE labelled relationship each ──────────────────────────
GoSurface --> Launch : resolve the launch, host-side
GoSurface --> Defs : read manifests
GoSurface --> Artifacts : pull / load images
GoSurface --> Runtime : sbx · workspace · state dir
GoSurface ..> RepoRoot : embedded manifests
Launch --> Runtime : renders the run for sbx
Defs --> Artifacts : build · deploy
Defs ..> GoSurface : entrypoint baked in
Maint ..> Defs : build / test targets
Maint ..> GoSurface : run · list
Dist ..> RepoRoot : release config
Artifacts ..> Runtime : inference (brokered by sbx)
Specs ..> RepoRoot : reasoning behind the rules
Specs ..> GoSurface : one file per concern

' ── Inside a group: how its own parts fit together ──────────────────────────
ProveoCLI --> Manifest : load targets
ProveoCLI --> Workspace : scope + mounts
ProveoCLI --> Runner : run.Do
Runner --> EgressPkg : Spec + Run
ProveoCLI --> CredPkg : detect provider
ProveoCLI --> GitId : forward identity
ProveoEP --> EPPkg : prep / exec

LaunchSpec --> KitEmit
KitEmit ..> Seed : setup.startup

CodingDefs *-- HarnessManifest
CodingDefs *-- DefBuild
CodingDefs *-- DefAssets
MaintainPkg ..> ImageBuildPkg : build · deploy steps
ImageBuildPkg ..> DefBuild : buildx over each Dockerfile

Mise ..> MaintLib

Installer ..> Goreleaser : downloads release
CliCDN ..> Goreleaser : hosts assets

UsageSpec ..> ComponentsSpec
Paradigms ..> HarnessSpecs
TestingSpec ..> Internals

note right of ProveoCLI
**Single host orchestrator.**
Refuses without sbx, resolves mounts,
credentials and the env wizard, then hands
one launch to sbx. Consumer install is the
static binary only — not a curl|bash of
live shell libs.
end note


note bottom of EgressPkg
sbx's own policy decides egress; the Kit
adds only add-on reach. Credentials go to
sbx's secret store and its proxy injects
them. Evidence: sbx's policy log at teardown.
(Until 2026-10-16: proveo-egress MITM +
broker + Squid, per tier. Deleted.)
end note

note bottom of LaunchSpec
  **One resolved launch, one rendering.** Every
  decision is made host-side and handed over as
  values, so the sbx Kit renders the struct
  rather than repeating the reasoning. A docker
  argv carried the same intent until 2026-10-16.
end note

note bottom of GoSurface
  **Every boundary is crossed exactly once.**
  Between groups the map records one labelled
  relationship rather than the dozen component
  pairs implementing it, so a reader following a
  package edge always knows where to look next.
end note

@enduml
