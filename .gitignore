.aider*
.cecli*
.copilot*
.opencode/
# Project-scoped agent config IS shared: .claude/skills, agents, commands and
# settings.json encode repo invariants a teammate needs. Only the machine-local
# permission grants are ignored — they accumulate absolute paths from whatever
# session wrote them.
.claude/settings.local.json

# .agents/ holds org-level skills sourced from proveo-ca (e.g. the `spec` diagram
# conventions), not assets this repo owns. Vendoring them here would fork an
# upstream asset into one consumer — the same reason `spec` includes the identity
# palette remotely instead of copying it. .claude/skills/spec symlinks into that
# tree, so the link is local too.
.agents/
.claude/skills/spec

# --- Sample monorepo (self-contained for testing) ---
!e2e/samples/


# --- Logs ---
logs/
*.log
reports/
# Accidental Go binaries at repo root (use: mise run build-cli → GOPATH/bin)
/proveo
/proveo-egress
/proveo-entrypoint

# Staged CDN Go binaries (mise run stage-cli; regenerated for deploy)
apps/cli/public/cli/bin/proveo-*
apps/cli/public/cli/checksums.txt

# Go coverage data dirs (go tool covdata)
cov/
*.coverprofile

# Diagram renders. _spec/**/*.puml is the source of truth and every diagram is
# regenerated on demand (plantuml -tsvg / -tpng); a checked-in render goes stale
# the moment its source changes. Validate with `plantuml -checkonly`, which
# writes nothing. Curated README assets under _spec/_assets are not renders.
_spec/**/*.svg
_spec/**/*.png
!_spec/_assets/**
