#!/bin/sh
# SPEC: _spec/_devops/git-hooks.puml
PATH="/usr/local/bin:$HOME/.local/bin:$PATH"; export PATH
cd "$(git rev-parse --show-toplevel)" || exit 1
command -v mise >/dev/null 2>&1 || { echo 'post-commit: mise not on PATH; skip fmt/lint' >&2; exit 0; }
exec mise exec -- go run ./cmd/proveo-dev hooks post-commit "$@"
