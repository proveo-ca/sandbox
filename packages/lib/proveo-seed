#!/usr/bin/env bash
# SPEC: _spec/packages/lib/seed-and-launch.puml, _spec/internal/sbx/startup-dispatch.puml
set -euo pipefail
# shellcheck source=/dev/null
source /entrypoint-lib.sh
phase="${2:-${PROVEO_SEED_PHASE:-all}}"
done_marker="${PROVEO_SEED_DONE_MARKER:-/dev/shm/proveo-seed-done}"
if [[ "$phase" == provision ]]; then
  if [[ -e "$PROVEO_SEED_REFUSED" || -e "$PROVEO_SEED_HALTED" ]]; then
    : > "$done_marker" 2>/dev/null || true
    exit 0
  fi
else
  rm -f "$done_marker" "$PROVEO_SEED_HALTED" 2>/dev/null || true
  proveo_seed_step starting "preparing OpenCode seed" "${1:-}"
fi
# A seed miss must not tear the sandbox down. sbx's durable-startup dispatcher
# treats any non-zero startup command as fatal and `exit $rc`s the container
# while the agent session is already live (~15s into a go.mod workspace).
rc=0
proveo_restore_image_path
proveo_seed "$@" || rc=$?
[[ -e "$PROVEO_INSTRUCTIONS_MARKER" ]] || proveo_release_agent "${1:-}"
if [[ "$phase" == release ]]; then
  (( rc == 0 )) || : > "$PROVEO_SEED_HALTED" 2>/dev/null || true
else
  : > "$done_marker" 2>/dev/null || true
fi
if (( rc != 0 )); then
  printf 'proveo-seed: proveo_seed exited %s — continuing; a seed miss must not tear the sandbox down\n' "$rc" >&2
fi
exit 0
