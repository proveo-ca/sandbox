#!/usr/bin/env python3
# SPEC: _spec/defs/opencode/native-v2-integration.puml, _spec/_paradigms/credential-boundary.puml
import os
import signal
import sys

from opencode_startup import SeedWait

command = sys.argv[1:]
if not command:
    sys.exit(64)
if os.environ.get("SANDBOX_VM_ID") and command[0] == "/entrypoint.sh" and command[1:3] == ["sh", "-c"] and len(command) > 3 and "sleep infinity" in command[3]:
    os.execv(command[0], command)
if os.environ.get("SANDBOX_VM_ID") and command[0] == "/entrypoint.sh" and os.environ.get("PROVEO_WORKDIR"):
    marker = os.environ.get("PROVEO_SEED_DONE_MARKER", "/dev/shm/proveo-seed-done")
    refused = os.environ.get("PROVEO_SEED_REFUSED", "/dev/shm/proveo-seed-refused")
    import time
    deadline = time.monotonic() + 300
    def stop(sig, _):
        sys.exit(128 + sig)

    previous = {sig: signal.signal(sig, stop) for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)}
    try:
        with SeedWait(os.environ, "starting: waiting for seed completion") as progress:
            while not os.path.exists(marker) and not os.path.exists(refused) and time.monotonic() < deadline:
                progress.update()
                time.sleep(0.1)
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)
    if not os.path.exists(marker) or os.path.exists(refused):
        print("proveo: OpenCode seed did not complete; inspect /var/log/sbx-kit-startup.log", file=sys.stderr)
        sys.exit(78)
runtime = os.environ.get("PROVEO_OPENCODE_RUNTIME_WRAPPER", "/usr/local/bin/proveo-opencode-runtime")
os.execv(runtime, [runtime, "--preflight-command", *command])
