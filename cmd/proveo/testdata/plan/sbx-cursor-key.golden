== sbx argv ==
sbx run --name proveo-cursor-<WORKHASH> --kit /st/sbx/kit -t proveo/cursor:latest -m 8192m -e CURSOR_API_KEY -e PROVEO_AGENT_EVIDENCE=default -e GIT_AUTHOR_NAME=Executor -e HOME=/proveo-home -e PROVEO_HOME=/proveo-home -e PROVEO_WORKDIR=<WORK> -e GIT_DISCOVERY_ACROSS_FILESYSTEM=1 -e MCP_GATEWAY_URL= cursor <WORK>
== secret names ==
== kit spec.yaml ==
schemaVersion: "2"
kind: mixin
name: cursor-posture
displayName: proveo posture (cursor)
description: Reachability, host-resolved environment and the seed step for a proveo run.
permissions:
    network:
        allow:
            - '*.cursor.com'
            - '*.cursor.sh'
            - api2.cursor.sh
            - cursor.com
            - cursor.sh
environment:
    variables:
        GIT_AUTHOR_NAME: Executor
        GIT_DISCOVERY_ACROSS_FILESYSTEM: "1"
        HOME: /proveo-home
        MCP_GATEWAY_URL: ""
        PROVEO_AGENT_EVIDENCE: default
        PROVEO_HOME: /proveo-home
        PROVEO_WORKDIR: <WORK>
setup:
    startup:
        - command:
            - /bin/sh
            - -c
            - |-
              set +e
              /usr/local/bin/proveo-seed "$1"
              rc=$?
              if [ "$rc" -ne 0 ]; then
                printf 'proveo-seed: exit %s — continuing; a seed miss must not tear the sandbox down\n' "$rc" >&2
              fi
              exit 0
            - proveo-seed
            - cursor
          user: "1000"
          description: 'proveo: compose subagents, settings and workspace trust'
        - command:
            - /usr/bin/env
            - PROVEO_SEED_ONLY=1
            - /entrypoint.sh
          user: "1000"
          description: 'proveo: the def''s own wiring, launch skipped'
