== sbx argv ==
sbx run --name proveo-sid --kit /st/sbx/kit -t proveo/claudecode:latest -m 4096m --clone -e ANTHROPIC_BASE_URL=https://api.anthropic.com -e PROVEO_AGENT_EVIDENCE=verbose -e GIT_AUTHOR_NAME=Executor -e HOME=/proveo-home -e PROVEO_HOME=/proveo-home -e PROVEO_SCOPE_REL=apps/web -e PROVEO_WORKDIR=<WORK> -e MCP_GATEWAY_URL= shell <WORK> <DATA>:ro
== secret names ==
CLAUDE_CODE_OAUTH_TOKEN
ANTHROPIC_API_KEY
== kit spec.yaml ==
schemaVersion: "2"
kind: mixin
name: claudecode-posture
displayName: proveo posture (claudecode)
description: Reachability, host-resolved environment and the seed step for a proveo run.
permissions:
    network:
        allow:
            - .anthropic.com
            - api.anthropic.com
            - statsig.anthropic.com
environment:
    variables:
        ANTHROPIC_BASE_URL: https://api.anthropic.com
        GIT_AUTHOR_NAME: Executor
        HOME: /proveo-home
        MCP_GATEWAY_URL: ""
        PROVEO_AGENT_EVIDENCE: verbose
        PROVEO_HOME: /proveo-home
        PROVEO_SCOPE_REL: apps/web
        PROVEO_WORKDIR: <WORK>
setup:
    startup:
        - command:
            - /usr/local/bin/proveo-seed
            - claudecode
          user: "1000"
          description: 'proveo: compose subagents, settings and workspace trust'
