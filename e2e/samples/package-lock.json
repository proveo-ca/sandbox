{
  "name": "polyglot-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "polyglot-monorepo",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/tui": {
      "name": "tui-app"
    },
    "node_modules/@polyglot/utils": {
      "resolved": "packages/utils",
      "link": true
    },
    "node_modules/@proveo/images-lib": {
      "resolved": "packages/lib",
      "link": true
    },
    "node_modules/tui-app": {
      "resolved": "apps/tui",
      "link": true
    },
    "packages/lib": {
      "name": "@proveo/images-lib"
    },
    "packages/utils": {
      "name": "@polyglot/utils",
      "version": "1.0.0"
    }
  }
}
