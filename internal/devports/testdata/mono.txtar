{"scripts":{"dev":"vite --port 3001","preview":"vite preview","storybook":"storybook dev -p 6006"}}
-- apps/web/package.json --
{"scripts":{"dev":"next dev","build":"next build","start":"next start"}}
-- mise.toml --
[tasks.serve]
run = "uvicorn app:api --port 8001"

[tasks.lint]
run = "eslint ."
-- package.json --
{"scripts":{"dev":"turbo run dev","build":"turbo run build"}}
