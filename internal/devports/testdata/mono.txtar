-- Makefile --
dev:
	hugo server

build:
	hugo
-- Procfile --
web: gunicorn app:wsgi --bind 0.0.0.0:5050
worker: celery worker
-- apps/api/main.go --
package main

import "net/http"

func main() { _ = http.ListenAndServe(":8080", nil) }
