# SPEC: _spec/components.puml
# Single registration point for the claudecode harness (Plan 2). Adding or
# changing a harness should touch only this file + the def dir it lives in.
name: claudecode
description: ML-loop harness (Claude Code, --dangerously-skip-permissions)
egress: true
docker: sbx
subscription: true
stability: candidate
images:
  claudecode: proveo/claudecode:latest
  claudecode-browser: proveo/claudecode-browser:latest
  # mcp + Solidity/security toolchain (Foundry, solc, solhint, semgrep)
  claudecode-solidity: proveo/claudecode-solidity:latest
workspace:
  layout: app
  configDir: .claude
  gitMode: rw
  # claudecode writes its deliverables to the output mount, which the app layout
  # makes explicit (the retired input-output layout bound it unconditionally).
  output: true
home:
  enabled: true
  mounts:
    - host: .claude
      container: /proveo-home/.claude
      mode: rw
env:
  - name: CLAUDE_CODE_OAUTH_TOKEN
    description: Claude Code OAuth token — generate one with `claude setup-token`
    secret: true
# proveo's own defaults for the agent, on every backend; an operator who sets the
# variable keeps their value. The classic renderer is part of agent evidence —
# fullscreen draws on the alternate screen and leaves nothing in scrollback for
# the transcript tee — and only an env var out-ranks a `tui` setting a mounted
# home may carry. DISABLE_ALTERNATE_SCREEN is the documented opt-out (Claude
# Code 2.1.132+); NO_FLICKER=0 is the older switch and covers images pinned
# before it. See _spec/defs/claudecode/claudecode-paradigm.puml.
agentEnv:
  CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN: "1"
  CLAUDE_CODE_NO_FLICKER: "0"

capabilities:
  providers: [anthropic]
  # Claude in Chrome: the agent drives the OPERATOR's Chrome through proveo's
  # bridge — add-on "chrome (host browser)", off by default, docker backend only.
  hostBrowser: claude-in-chrome
