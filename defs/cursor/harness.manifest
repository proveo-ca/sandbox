# SPEC: _spec/components.puml
name: cursor
description: Policy-gated autonomous loop (Cursor CLI, --force + native deny rules)
egress: true
dind: true
provider: cursor
subscription: true
stability: candidate
images:
  cursor: proveo/cursor:latest
  cursor-browser: proveo/cursor-browser:latest
workspace:
  layout: app
  configDir: .cursor
  gitMode: rw
home:
  enabled: true
  mounts:
    - host: .cursor
      container: /proveo-home/.cursor
      mode: rw
      deny: [auth.json]
env:
  - name: CURSOR_API_KEY
    description: Cursor API key — create one at cursor.com/dashboard → API Keys
    secret: true

capabilities:
  egress: [open]
  credentials: [forward]
  providers: [cursor]
