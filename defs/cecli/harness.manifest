# SPEC: _spec/components.puml
name: cecli
description: Pair-programming specialist (cecli/aider, low-token, human-guided)
egress: true
docker: dind
stability: candidate
images:
  cecli: proveo/cecli:latest
workspace:
  layout: app
  configDir: .cecli
  gitMode: rw
  output: true
home:
  enabled: true
  mounts:
    - host: .cecli
      container: /proveo-home/.cecli
      mode: rw
