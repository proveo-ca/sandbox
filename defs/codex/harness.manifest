# SPEC: _spec/components.puml, _spec/defs/codex/codex-topology.puml
# Single registration point for the codex harness (Plan 2). Adding or changing a
# harness should touch only this file + the def dir it lives in.
name: codex
description: ML-loop harness (Codex CLI, --dangerously-bypass-approvals-and-sandbox)
subscription: true
stability: candidate
images:
  codex: proveo/codex:latest
  # The browser layer applied onto proveo/codex; selected per run as the `browser` addon.
  codex-browser: proveo/codex-browser:latest
workspace:
  layout: app
  # $CODEX_HOME is ~/.codex; .codex/ in the REPO is the project-scoped half
  # (project agents + rules), which the monorepo-subdir case must preserve.
  configDir: .codex
  gitMode: rw
home:
  enabled: true
  mounts:
    - host: .codex
      container: /proveo-home/.codex
      mode: rw
      # No deny list: `codex login`'s auth.json IS the ChatGPT-plan credential.
env:
  - name: OPENAI_API_KEY
    description: OpenAI API key — create one at platform.openai.com/api-keys, or run `codex login` for a ChatGPT plan
    secret: true

capabilities:
  providers: [openai]
