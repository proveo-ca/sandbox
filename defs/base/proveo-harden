#!/bin/sh
# proveo-harden strips setuid/setgid bits and removes a couple of network
# probes. It runs after every package-installing layer.
#
# SUDO IS EXEMPT, and that exemption is the whole reason this file has comments.
# The harness base descends from docker/sandbox-templates, whose runtime user
# `agent` reaches root ONLY through /usr/bin/sudo -> /usr/bin/sudo.ws, a setuid
# binary. A blanket `chmod u-s` disarms it, and a sandbox whose agent cannot
# reach root is one where the Docker daemon cannot start — which is the shape of
# "Permission denied (you must be root)" recorded against dockerd in
# _spec/_plans/image-size-reduction.puml. That record acquitted proveo-harden,
# but it was measured on a Debian base carrying no sudo at all, so the test was
# never like-for-like.
#
# The exemption is deliberately narrow: ssh-agent and ssh-keysign, the only
# other setuid/setgid files the template ships, stay stripped. Neither is a
# privilege the harness uses.
# SPEC: _spec/_devops/sandbox-template-rebase.puml, _spec/defs/harden-pass.puml

if [ "$#" -eq 0 ]; then
  set -- /
fi

for root in "$@"; do
  find "$root" -xdev \( -perm -4000 -o -perm -2000 \) -type f -print 2>/dev/null
done | while IFS= read -r f; do
  case "$f" in
    */sudo|*/sudo.ws|*/sudoedit|*/sudoedit.ws) continue ;;
  esac
  chmod u-s,g-s "$f" 2>/dev/null || true
done

rm -f /usr/bin/nc /usr/bin/netcat /bin/netstat /usr/bin/ss || true
