# SPEC: _spec/components.puml, _spec/defs/hermes/hermes-paradigm.puml
name: hermes
description: Hermes Agent (NousResearch) — general-purpose assistant with native browser automation
egress: true
docker: sbx
stability: candidate
images:
  hermes: proveo/hermes:latest
  hermes-muse-glimmer: proveo/hermes-muse-glimmer:latest
  hermes-qwen3.8: proveo/hermes-qwen3.8:latest
workspace:
  layout: app
  configDir: .hermes
  gitMode: rw
home:
  enabled: true
  mounts:
    - host: hermes/data
      container: /proveo-home/data
      mode: rw

# Provider keys are usage keys (brokered, no auth row), as for cecli; the list
# is proveo's registry where hermes reads the same key env var.
# SPEC: _spec/defs/hermes/hermes-paradigm.puml, _spec/internal/credentials/credential-decisions.puml
capabilities:
  providers: [anthropic, bedrock, deepinfra, deepseek, fireworks, gmi, google,
              huggingface, minimax, nebius, novita, openai, openrouter, xai, zai]
  hosts: [] # browser targets are open-ended by design; the operator's own egress policy scopes them
