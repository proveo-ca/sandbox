# Filters the repo-root build context (Context "." in internal/imagebuild/targets.go).
# A denylist on purpose: never list a path a Dockerfile COPYs.
# defs/cecli/Dockerfile.dockerignore replaces this file for cecli builds and repeats it.

# JS toolchain: never copied by any Dockerfile, and the bulk of the context.
node_modules
**/node_modules
.pnpm-store

# The CLI's web assets — built and published by wrangler, not by any image.
apps

# VCS. Nothing in a build reads it; `go build` simply skips VCS stamping.
.git
.gitattributes
.gitignore

# Local test/build output.
cov
dist
*.out
*.log
.DS_Store

# Agent- and editor-local state.
.claude
.vscode
.idea
